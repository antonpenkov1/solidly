    "Contains %@ — one of the top-9 allergens. Offer it at home, earlier in the day, and keep it in the diet once it goes well.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Содержит «%@» — один из топ-9 аллергенов. Давайте дома, в первой половине дня, и оставьте в рационе, если всё прошло хорошо."
          }
        }
      }
    },
    "Continue": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Далее"
          }
        }
      }
    },
    "Cut safely": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Резать правильно"
          }
        }
      }
    },
    "Cut with care — this food can form a choking shape if served whole or in coins.": {
      "localizations": {
