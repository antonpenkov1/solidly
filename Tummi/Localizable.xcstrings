                  "value": "Не раньше %lld месяца"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Не раньше %lld месяцев"
                }
              }
            }
          }
        }
      }
    },
    "Not tried yet: %@": {
      "localizations": {
        "ru": {
