    "Weekly, only when something introduced has been quietly dropped": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Раз в неделю и только если введённое незаметно перестали давать"
          }
        }
      }
    },
    "Weigh-in nudge": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напоминание о взвешивании"
          }
        }
      }
    },
