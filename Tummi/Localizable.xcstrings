            "value": "Заметка"
          }
        }
      }
    },
    "Nothing here": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь пусто"
          }
        }
      }
    },
    "Nothing logged today yet.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сегодня пока ничего не записано."
          }
        }
      }
    },
    "Nothing logged yet": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записей пока нет"
          }
        }
      }
    },
    "Nothing logged yet today.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сегодня пока ничего не записано."
          }
        }
      }
    },
    "Notifications are turned off for Spoonlet in iOS Settings, so these will not appear.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведомления для Spoonlet выключены в настройках iOS — эти напоминания не появятся."
          }
        }
      }
    },
    "Open Spoonlet to get started": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте Spoonlet, чтобы начать"
          }
        }
      }
    },
    "Optional": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Необязательно"
          }
        }
      }
    },
    "Plan": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "План"
          }
        }
      }
    },
    "Preferences": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предпочтения"
          }
        }
      }
    },
    "Reads back today's milk and solid food against the guidance range for the baby's age.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зачитывает, сколько молока и еды сегодня, относительно диапазона для возраста ребёнка."
          }
        }
      }
    },
    "Recent": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Недавнее"
          }
        }
      }
    },
    "Record something": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сделать запись"
          }
        }
      }
    },
    "Records a bottle feed for the current baby.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записывает кормление из бутылочки текущему ребёнку."
          }
        }
      }
    },
    "Records how much solid food the baby ate. Which foods and how it went can be added in the app.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записывает, сколько прикорма съел ребёнок. Какие продукты и как прошло — можно добавить в приложении."
          }
        }
      }
    },
    "Refused": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отказался"
          }
        }
      }
    },
    "Refusing is normal — it can take 10–15 offers of a new food before a child accepts it.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отказ — это нормально: иногда новый продукт нужно предложить 10–15 раз, прежде чем ребёнок его примет."
          }
        }
      }
    },
    "Regular repeat exposure is what the prevention trials tested — roughly twice a week, not one taste.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В исследованиях по профилактике проверяли именно регулярное повторное употребление — примерно дважды в неделю, а не одну пробу."
          }
        }
      }
    },
    "Reminders": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напоминания"
          }
        }
      }
    },
    "Replace any number with the one your doctor gave you": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Замените любую цифру на ту, что дал ваш врач"
          }
        }
      }
    },
    "Reset all my overrides": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сбросить все мои изменения"
          }
        }
      }
    },
    "Rich in": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Богат"
          }
        }
      }
    },
    "Right": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Правая"
          }
        }
      }
    },
    "Save": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранить"
          }
        }
      }
    },
    "Search foods": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поиск продуктов"
          }
        }
      }
    },
    "Series": {
      "extractionState": "manual",
      "shouldTranslate": false
    },
    "Settings": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройки"
          }
        }
      }
    },
    "Sex": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пол"
          }
        }
      }
    },
    "Shown next to every number this changes, so you can always tell your doctor's plan from the published ranges.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывается рядом с каждой изменённой цифрой, чтобы вы всегда отличали план врача от опубликованных диапазонов."
          }
        }
      }
    },
    "Side": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Грудь"
          }
        }
      }
    },
    "Six or more wet nappies a day is the usual sign that a young baby is getting enough milk.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Шесть и больше мокрых подгузников в сутки — обычный признак того, что маленькому ребёнку хватает молока."
          }
        }
      }
    },
    "Sleep": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сон"
          }
        }
      }
    },
    "Sleeping": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спит"
          }
        }
      }
    },
    "Sleeping for %@": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спит уже %@"
          }
        }
      }
    },
    "Sleeping since %@": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спит с %@"
          }
        }
      }
    },
    "Snacks a day": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перекусов в день"
          }
        }
      }
    },
    "Sources": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Источники"
          }
        }
      }
    },
    "Spoonlet": {
      "extractionState": "manual",
      "shouldTranslate": false
    },
    "Spoonlet does not have opinions of its own. Everything it says traces to one of these.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У Spoonlet нет собственного мнения. Всё, что оно говорит, восходит к одному из этих источников."
          }
        }
      }
    },
    "Spoonlet has no account and no server. Everything lives in this app's storage on this device, and nothing is sent anywhere unless you export it yourself.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У Spoonlet нет аккаунта и сервера. Всё живёт в хранилище приложения на этом устройстве, и никуда не отправляется, пока вы сами не сделаете экспорт."
          }
        }
      }
    },
    "Spoonlet is not a doctor": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Spoonlet — не врач"
          }
        }
      }
    },
    "Spoonlet needs a date of birth to know which guidance applies.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Spoonlet нужна дата рождения, чтобы понять, какие рекомендации применять."
          }
        }
      }
    },
    "Spoonlet summarises published infant feeding guidance. It is not a medical device, it does not diagnose, and it cannot examine your baby. Always check with your paediatrician before making decisions about feeding, supplements or allergen introduction — and seek urgent care for breathing difficulty, facial swelling, repeated vomiting after a food, or a baby who stops feeding.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Spoonlet пересказывает опубликованные рекомендации по питанию детей. Это не медицинское изделие, оно не ставит диагнозов и не может осмотреть вашего ребёнка. Всегда сверяйтесь с педиатром, принимая решения о питании, добавках и введении аллергенов, и обращайтесь за срочной помощью при затруднённом дыхании, отёке лица, многократной рвоте после продукта или если ребёнок перестал есть."
          }
        }
      }
    },
    "Spoonlet will use corrected age for feeding milestones and growth charts, which is how they are meant to be read for preterm babies.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Spoonlet будет использовать скорректированный возраст для этапов прикорма и кривых роста — именно так их и положено читать для недоношенных детей."
          }
        }
      }
    },
    "Start a nap": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начать сон"
          }
        }
      }
    },
    "Suitable now": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подходит сейчас"
          }
        }
      }
    },
    "Supplement": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавка"
          }
        }
      }
    },
    "System": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Системное"
          }
        }
      }
    },
    "Tap any number below to replace it with the one your doctor gave you.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите на любую цифру ниже, чтобы заменить её на ту, что дал ваш врач."
          }
        }
      }
    },
    "Tap any source to read it": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите на источник, чтобы прочитать"
          }
        }
      }
    },
    "Tasted": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Попробовал"
          }
        }
      }
    },
    "That date is in the future.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта дата в будущем."
          }
        }
      }
    },
    "The 30th percentile means 30 of 100 healthy babies of the same age and sex weigh less. There is no good or bad number — a baby tracking steadily along the 15th is thriving, and a baby dropping from the 75th to the 25th is worth a conversation even though both numbers look fine.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "30-й перцентиль означает, что 30 из 100 здоровых детей того же возраста и пола весят меньше. Хороших и плохих цифр здесь нет: ребёнок, стабильно идущий по 15-му, растёт прекрасно, а ребёнок, съехавший с 75-го на 25-й, — повод для разговора, хотя обе цифры выглядят нормально."
          }
        }
      }
    },
    "The green chips are links": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зелёные плашки — это ссылки"
          }
        }
      }
    },
    "The little green chips under each card open the guideline or study it came from. That is the whole point of Spoonlet — nothing here asks you to take its word for it.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Маленькие зелёные плашки под каждой карточкой открывают гайд или исследование, откуда взята рекомендация. В этом весь смысл Spoonlet: оно не просит верить на слово."
          }
        }
      }
    },
    "These were introduced but have not been offered lately: %@.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти уже вводили, но давно не давали: %@."
          }
        }
      }
    },
    "This is a hard limit with a safety reason behind it, not a preference. Read the sources below.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это жёсткое ограничение с механизмом безопасности за ним, а не вопрос предпочтений. Прочитайте источники ниже."
          }
        }
      }
    },
    "Three reminders, and nothing else. Spoonlet will never nag you about feeds — you already know when your baby is hungry.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Три напоминания и больше ничего. Spoonlet никогда не будет напоминать о кормлениях — вы и так знаете, когда ребёнок голоден."
          }
        }
      }
    },
    "Time for a weigh-in": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пора взвесить"
          }
        }
      }
    },
    "Timeline": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хронология"
          }
        }
      }
    },
    "Today": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сегодня"
          }
        }
      }
    },
    "Today so far": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сегодня уже"
          }
        }
      }
    },
    "Today's food and milk against the guidance range for your baby's age.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Еда и молоко за сегодня относительно диапазона для возраста ребёнка."
          }
        }
      }
    },
    "Today's guidance is %1$@ meals and about %2$@ of food. Log a feed and Spoonlet will start tracking against it.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ориентир на сегодня — %1$@ приёмов пищи и около %2$@ еды. Запишите кормление, и Spoonlet начнёт сверять."
          }
        }
      }
    },
    "Today's guidance is %1$@ milk feeds. Log one and Spoonlet will start tracking against it.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ориентир на сегодня — %1$@ молочных кормлений. Запишите одно, и Spoonlet начнёт сверять."
          }
        }
      }
    },
    "Today's guidance range is %1$@ across %2$@ meals.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ориентир на сегодня — %1$@ за %2$@ приёмов."
          }
        }
      }
    },
    "Track grams, millilitres, growth and allergen exposures": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Считайте граммы, миллилитры, рост и контакты с аллергенами"
          }
        }
      }
    },
    "Tried once, on %@.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пробовали один раз, %@."
          }
        }
      }
    },
    "Trouble breathing, a swollen face or lips, repeated vomiting after a food, blood in stool, or a baby who has stopped feeding — contact emergency services or your doctor, not an app.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Затруднённое дыхание, отёк лица или губ, многократная рвота после продукта, кровь в стуле или ребёнок перестал есть — звоните в скорую или врачу, а не открывайте приложение."
          }
        }
      }
    },
    "Trouble breathing, swelling of the face or lips, or repeated vomiting needs emergency care now — not a log entry.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Затруднённое дыхание, отёк лица или губ, многократная рвота — это повод вызвать скорую прямо сейчас, а не сделать запись в дневнике."
          }
        }
      }
    },
    "Try another search or filter.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Попробуйте другой запрос или фильтр."
          }
        }
      }
    },
    "Under every recommendation you will see something like “WHO, 2023”. Tap it and the actual guideline opens. Nothing in Spoonlet asks you to take its word for it.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Под каждой рекомендацией вы увидите что-то вроде «WHO, 2023». Нажмите — откроется сам гайд. Spoonlet нигде не просит верить на слово."
          }
        }
      }
    },
    "Units": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Единицы"
          }
        }
      }
    },
    "Use my doctor's number": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использовать цифру врача"
          }
        }
      }
    },
    "Use the buttons above": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кнопки сверху"
          }
        }
      }
    },
    "Usually from %lld mo": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обычно с %lld мес"
          }
        }
      }
    },
    "Usually from %lld months": {
      "localizations": {
        "ru": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Обычно с %lld месяцев"
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Обычно с %lld месяцев"
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Обычно с %lld месяца"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Обычно с %lld месяцев"
                }
              }
            }
          }
        }
      }
    },
    "Value": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Значение"
          }
        }
      }
    },
    "WHO Child Growth Standards": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стандарты роста детей ВОЗ"
          }
        }
      }
    },
    "WHO, ESPGHAN, AAP, NIAID and the trials behind them": {
      "localizations": {
