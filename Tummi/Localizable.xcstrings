      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вес"
          }
        }
      }
    },
    "Weight, length and head circumference on the real WHO curves.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вес, длина и окружность головы на настоящих кривых ВОЗ."
